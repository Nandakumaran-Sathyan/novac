# Run requests from VS Code (REST Client extension) or Rider/Visual Studio.
@host = http://localhost:5080

### Health (includes SQL Server connectivity)
GET {{host}}/health

### List applications (search + filter + paging)
GET {{host}}/api/applications?search=rao&page=1&pageSize=10

### Get one application
GET {{host}}/api/applications/1

### Create a valid application
POST {{host}}/api/applications
Content-Type: application/json

{
  "applicantName": "Test Applicant",
  "monthlyIncome": 85000,
  "existingMonthlyDebt": 6000,
  "loanAmount": 500000,
  "annualInterestRate": 11.25,
  "tenureMonths": 48,
  "employmentType": "Salaried"
}

### Create an invalid application (expect 400 with field errors)
POST {{host}}/api/applications
Content-Type: application/json

{
  "applicantName": "",
  "loanAmount": -5,
  "annualInterestRate": 150,
  "tenureMonths": 0,
  "monthlyIncome": 1000.555
}

### Run the deterministic assessment
POST {{host}}/api/applications/1/assess
