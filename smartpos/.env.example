# SmartPOS API configuration via environment variables.
# Copy to .env (git-ignored), fill in real values, then load it into your shell before
# starting the API:   set -a; source .env; set +a; dotnet run --project backend/src/SmartPOS.API
# For local development, `dotnet user-secrets` is the recommended alternative (see README).
# ASP.NET Core maps "__" (double underscore) to the ":" section separator.

# --- Required ---------------------------------------------------------------
# PostgreSQL 14+ connection string for the application user (NOT the postgres superuser).
ConnectionStrings__SmartPos=Host=127.0.0.1;Port=5432;Database=smartpos_dev;Username=smartpos;Password=CHANGE_ME

# JWT signing key, at least 32 characters. Generate with: openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# --- Accounts ---------------------------------------------------------------
# There is no seeded or default account. Each user registers (POST /api/auth/register or the
# "Create an account" page) and gets a shop of their own.

# --- Optional (defaults in appsettings.json) ---------------------------------
# ASPNETCORE_ENVIRONMENT=Development
# Store__CurrencyCode=INR
# Store__TimeZoneId=Asia/Kolkata
# Pos__TaxRatePercent=5
# Pos__MaxDiscountPercent=100
# Loyalty__SpendPerPoint=100         # 1 loyalty point per this much spent (rounded down)

# --- Email (verification links) ----------------------------------------------
# App__WebBaseUrl=https://pos.example.com   # used to build the link in the email
# Email__Smtp__Host=smtp.example.com        # leave empty in development to print emails to the API log instead
# Email__Smtp__Port=587
# Email__Smtp__UseSsl=true
# Email__Smtp__User=you@example.com
# Email__Smtp__Password=CHANGE_ME           # keep this in user-secrets, not in a file
# Email__Smtp__From=no-reply@example.com
# Jwt__ExpiryMinutes=480
# Cors__AllowedOrigins__0=http://localhost:4200
# Database__SeedSampleData=false
# Database__SeedDemoHistory=false   # FABRICATED sales history for demos; Development only
# Database__DemoHistoryDays=90
