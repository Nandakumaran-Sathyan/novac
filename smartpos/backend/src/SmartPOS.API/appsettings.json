{
  // Non-secret defaults. Secrets (ConnectionStrings:SmartPos, Jwt:SigningKey, Email:Smtp:Password)
  // must come from `dotnet user-secrets` locally or environment variables in production.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartPos": ""
  },
  "Jwt": {
    "Issuer": "SmartPOS.Api",
    "Audience": "SmartPOS.Web",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },
  "Store": {
    "Name": "SmartPOS Store",
    "CurrencyCode": "INR",
    "TimeZoneId": "Asia/Kolkata"
  },
  "Pos": {
    "TaxRatePercent": 5,
    "MaxDiscountPercent": 100
  },
  "Loyalty": {
    "SpendPerPoint": 100
  },
  "App": {
    "WebBaseUrl": "",
    "EmailVerificationHours": 24
  },
  "Email": {
    "LogMessages": false,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "User": "",
      "Password": "",
      "From": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "SeedSampleData": false
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10
  }
}
