{
  // Non-secret defaults. Secrets (ConnectionStrings:SmartPos, Jwt:SigningKey, Email:Smtp:Password)
  // must come from `dotnet user-secrets` locally or environment variables in production.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartPos": ""
  },
  "Jwt": {
    "Issuer": "SmartPOS.Api",
    "Audience": "SmartPOS.Web",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },
  "Store": {
    "Name": "SmartPOS Store",
    "CurrencyCode": "INR",
    "TimeZoneId": "Asia/Kolkata"
  },
  "Pos": {
    "TaxRatePercent": 5,
    "MaxDiscountPercent": 100
  },
  "Ollama": {
    // Local AI model server. Only the backend talks to it; it must stay on this machine (see docs/AI.md).
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen3.5:9b",
    "TimeoutSeconds": 120,
    "Temperature": 0.2,
    "ContextLength": 8192,
    "Think": false,
    "KeepAlive": "10m"
  },
  "Assistant": {
    "MaxHistoryMessages": 12,
    "MaxHistoryCharacters": 8000,
    "MaxToolRounds": 3,
    "MaxToolCallsPerRound": 6,
    "RequestsPerMinute": 10
  },
  "Loyalty": {
    "SpendPerPoint": 100
  },
  "App": {
    "WebBaseUrl": "",
    "EmailVerificationHours": 24
  },
  "Email": {
    "LogMessages": false,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "User": "",
      "Password": "",
      "From": ""
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "SeedSampleData": false
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10
  }
}
