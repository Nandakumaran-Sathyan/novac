{
  // Non-secret defaults. Secrets (ConnectionStrings:SmartPos, Jwt:SigningKey, Bootstrap:AdminPassword)
  // must come from `dotnet user-secrets` locally or environment variables in production.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartPos": ""
  },
  "Jwt": {
    "Issuer": "SmartPOS.Api",
    "Audience": "SmartPOS.Web",
    "SigningKey": "",
    "ExpiryMinutes": 480
  },
  "Store": {
    "Name": "SmartPOS Store",
    "CurrencyCode": "INR",
    "TimeZoneId": "Asia/Kolkata"
  },
  "Pos": {
    "TaxRatePercent": 5,
    "MaxCashierDiscountPercent": 10,
    "MaxAdminDiscountPercent": 100
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "SeedSampleData": false
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10
  }
}
