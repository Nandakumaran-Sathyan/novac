{
  // Development overrides. No secrets here: set them with `dotnet user-secrets` (see README).
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Email": {
    // Mailpit (`brew install mailpit`, then run `mailpit`): a local SMTP server on 1025 that delivers nothing
    // to the internet; read the mail at http://localhost:8025. No account or password needed.
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseSsl": false,
      "User": "",
      "Password": "",
      "From": "SmartPOS <no-reply@smartpos.local>"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Database": {
    // Gives each newly registered shop a sample catalogue. Never creates users, customers or sales.
    "SeedSampleData": true,
    // FABRICATED bills, customers and stock movements for demos (see DemoHistory.cs). Never enable in production.
    "SeedDemoHistory": true,
    "DemoHistoryDays": 90
  }
}
