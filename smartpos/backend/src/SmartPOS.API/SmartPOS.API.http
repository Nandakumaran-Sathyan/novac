# Requests for the VS Code REST Client / JetBrains HTTP client.
# Log in first, then copy accessToken into @token.
@baseUrl = http://localhost:5080
@token = paste-access-token-here

GET {{baseUrl}}/health

###
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{ "email": "you@example.com", "password": "your-password" }

###
# Create an account together with its shop (returns the same body as login).
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{ "fullName": "Your Name", "email": "you@example.com", "password": "Use-a-real-passw0rd", "shopName": "My Shop", "shopAddress": "1 Main Street" }

###
GET {{baseUrl}}/api/dashboard/summary
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/products?search=milk&page=1&pageSize=20
Authorization: Bearer {{token}}

###
POST {{baseUrl}}/api/sales
Authorization: Bearer {{token}}
Content-Type: application/json

{ "items": [ { "productId": 1, "quantity": 2 } ], "discountPercent": 0, "paymentMethod": "Cash" }

###
GET {{baseUrl}}/api/reports/daily-sales?from=2026-10-01&to=2026-10-31
Authorization: Bearer {{token}}
